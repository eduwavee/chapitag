JWT_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"
DB_PATH="./data/app.db"

# Publicada en Vercel (sin disco): la base en Turso y las fotos en Vercel Blob.
# Con estas vacías se usan data/app.db y data/uploads/.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
# Vercel carga BLOB_STORE_ID sola al conectar un store privado al proyecto.
BLOB_READ_WRITE_TOKEN=""

# URL pública de la app, sin barra final. Es la que se graba en los chips NFC,
# va en los QR, en los emails y en la vista previa al compartir el link.
# En desarrollo se puede dejar vacía (se deduce del request).
APP_URL="https://tudominio.com.ar"

# Avisos por email (escaneos, ubicación compartida, recuperar contraseña) con
# Resend: https://resend.com. Sin API key, los emails se muestran en la
# consola del servidor en vez de enviarse.
RESEND_API_KEY=""
# Remitente con un dominio verificado en Resend.
EMAIL_FROM="ChapiTag <avisos@tudominio.com.ar>"
